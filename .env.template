# Copy this file to .env and fill in real values.
# In Codespaces, prefer Settings -> Codespaces -> Secrets instead of a local
# .env file — secrets set there are injected as environment variables
# automatically in every session. Never commit a filled-in .env.

# --- Property resolution (Sprint 0) ---
OS_PLACES_API_KEY=          # OS Data Hub -> add "Places API" product (60-day free trial).
                             # Used for address -> UPRN + coordinates.
OS_NAMES_API_KEY=           # Already registered. Gazetteer/place-name search only —
                             # NOT used for UPRN resolution (see Architecture Decisions,
                             # 2026-07-22). Kept in case gazetteer lookups are useful later.

# --- LLM (Sprint 2+) ---
GOOGLE_API_KEY=              # Gemini — Google AI Studio (free tier sufficient)
GROQ_API_KEY=                # Groq — free tier (model eval experiment only, Sprint 5)

# --- HMLR LLC1 (Sprint 1) ---
# Business Gateway Basic Auth, NOT a self-serve API key. Blocked as of
# 2026-07-22 pending law firm partner's account or channelpartners@landregistry.gov.uk.
HMLR_BG_USERNAME=
HMLR_BG_PASSWORD=

# --- Historic England (Sprint 1) ---
# Likely NOT required — NHLE listed buildings / conservation area data is
# published as open data (ArcGIS REST / WFS, Open Government Licence).
# Confirm when historic_england.py is built.
# HISTORIC_ENGLAND_KEY=
